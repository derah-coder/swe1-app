# Prepare a database directory outside the uploaded application code.
commands:
  01_create_database_directory:
    command: "install -d -m 0750 -o webapp -g webapp /var/app/data"

# Run after dependencies are installed, before the application starts.
container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
  02_database_permissions:
    command: "chown webapp:webapp /var/app/data/db.sqlite3 && chmod 600 /var/app/data/db.sqlite3"
